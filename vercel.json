{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/|assets/|fonts/|mockServiceWorker.js).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/mockServiceWorker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
