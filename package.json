{
  "name": "jungle-nft-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test",
    "test:data": "node --test tests/data/*.test.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:report": "playwright show-report playwright-report/development",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "ui:add": "npx --yes shadcn@4.21.5 add",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "@mswjs/socket.io-binding": "0.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "chrome-launcher": "1.2.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
